# ─────────────────────────────────────────────────────────────
# SmartCare API — Environment Configuration
# Copy this file to ".env" and adjust as needed.
# These defaults match a stock Laragon (MySQL) install on Windows.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (Laragon MySQL defaults: user "root", empty password, port 3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartcare
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# Auth / JWT — CHANGE THESE SECRETS IN PRODUCTION
JWT_ACCESS_SECRET=change_me_smartcare_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_smartcare_refresh_secret_dev_only
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# Uploads
UPLOAD_DIR=src/uploads
MAX_UPLOAD_MB=5

# Column-level encryption (national ID / health notes). 32-byte hex key.
# Generate a fresh one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Payment gateways (sandbox) ──
# Leave the *_ENABLED flags false to use SmartCare's built-in mock sandbox,
# which lets you complete the full payment flow with no merchant account.
ESEWA_ENABLED=false
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET=8gBm/:&EnhH.1/q
KHALTI_ENABLED=false
KHALTI_SECRET_KEY=test_secret_key_placeholder

# Notifications (optional — leave blank to log to console instead of sending)
# SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartCare <no-reply@smartcare.local>
# SMS (Sparrow SMS / similar)
SMS_TOKEN=
SMS_FROM=SmartCare
